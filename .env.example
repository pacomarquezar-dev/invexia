# Copia este archivo a .env.local y rellena los valores reales.
# Nunca commitees .env.local ni ningún valor real de estas variables.

# Clave de la API de Anthropic (modelo Claude Haiku) usada por /app/api/chat/route.ts.
# Solo debe configurarse como variable de entorno en Vercel (o en .env.local para desarrollo).
ANTHROPIC_API_KEY=

# URL pública del sitio, usada para metadatos (Open Graph), sitemap.xml y robots.txt.
# Opcional: si no se define, se usa "https://www.invexia.es" por defecto.
NEXT_PUBLIC_SITE_URL=
